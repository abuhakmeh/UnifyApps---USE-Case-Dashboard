# Claude powers the agents (Analyst, ROI, Brand, Ask). Without it the platform runs in keyword mode.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Protects editing on a public deployment. Viewers can browse; only holders of this key can add/edit.
ADMIN_TOKEN=change-me
# Where use cases and uploads are stored. Mount a persistent disk here in production.
DATA_DIR=./data
PORT=8787
# MAX_UPLOAD_MB=200
# DISABLE_BROWSER=true   # skip headless screenshots
